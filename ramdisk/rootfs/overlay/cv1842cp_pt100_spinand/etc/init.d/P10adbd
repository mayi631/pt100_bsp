#!/bin/sh

case "$1" in
  start)
    printf "Starting adbd: "
    if /etc/uhubon.sh device &&
       /etc/run_usb.sh probe adb &&
       /etc/run_usb.sh start; then
      echo "OK"
    else
      echo "FAIL"
      exit 1
    fi
    ;;
  stop)
    printf "Stopping adbd: "
    echo "OK"
    ;;
  restart|reload)
    /etc/run_usb.sh stop
    /etc/run_usb.sh probe adb
    /etc/run_usb.sh start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit $?
