--- a/components/cvi_mmf_sdk/cvi_panel/dsi_panels.h
+++ b/components/cvi_mmf_sdk/cvi_panel/dsi_panels.h
@@ -64,6 +64,15 @@ static struct panel_desc_s panel_desc = {
 	.dsi_init_cmds      = dsi_init_cmds_bjx2836f0,
 	.dsi_init_cmds_size = ARRAY_SIZE(dsi_init_cmds_bjx2836f0)
 };
+#elif CONFIG_PANEL_BJX2416F0
+#include "dsi_bjx2416f0.h"
+static struct panel_desc_s panel_desc = {
+	.panel_name         = "BJX2416F0-480x640",
+	.dev_cfg            = &dev_cfg_bjx2416f0,
+	.hs_timing_cfg      = &hs_timing_cfg_bjx2416f0,
+	.dsi_init_cmds      = dsi_init_cmds_bjx2416f0,
+	.dsi_init_cmds_size = ARRAY_SIZE(dsi_init_cmds_bjx2416f0)
+};
 #elif CONFIG_PANEL_HX8394
