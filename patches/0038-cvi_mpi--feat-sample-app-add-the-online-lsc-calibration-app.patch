+
+/* calib_mode: 0=MESH_CHROMA_MODE(chroma+luma 2-pass), 1=MESH_CHROMA_LUMA_MODE(single pass) */
+int run_lsc_calibration_offline_dir(const char *base_dir, int calib_mode, int enable_verify);
+
