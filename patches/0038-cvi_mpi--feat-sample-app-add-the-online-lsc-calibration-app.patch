+		stViDevAttr.enBayerFormat       = (BAYER_FORMAT_E)stSnsCfg->enBayerFormat[i];
+		stViDevBindAttr.PipeId[0]		= stSnsIniCfg->MipiDev[i];
+		stViDevBindAttr.u32Num			= 1;
