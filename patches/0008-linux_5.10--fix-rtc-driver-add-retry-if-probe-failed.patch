From 729f2809da181c145094499ad6457cf9505ef6fe Mon Sep 17 00:00:00 2001
From: "song.yu" <song.yu@sophgo.com>
Date: Sun, 4 Jan 2026 14:57:28 +0800
Subject: [PATCH] fix: rtc driver add retry if probe failed
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

复现方法：完全断电一段时间，重新上电的时候，
RTC 需要较长时间约1.6s 才能 probe 成功
---
 drivers/rtc/rtc-pcf8563.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/rtc/rtc-pcf8563.c b/drivers/rtc/rtc-pcf8563.c
index 2dc30eafa..8f3e3f79f 100644
--- a/drivers/rtc/rtc-pcf8563.c
+++ b/drivers/rtc/rtc-pcf8563.c
@@ -547,16 +547,16 @@ static int pcf8563_probe(struct i2c_client *client,
 	buf = PCF8563_TMRC_1_60;
 	err = pcf8563_write_block_data(client, PCF8563_REG_TMRC, 1, &buf);
 	if (err < 0) {
-		dev_err(&client->dev, "%s: write error\n", __func__);
-		return err;
+		dev_err(&client->dev, "%s: write error, defer probe\n", __func__);
+		return -EPROBE_DEFER;
 	}
 
 	/* Clear flags and disable interrupts */
 	buf = 0;
 	err = pcf8563_write_block_data(client, PCF8563_REG_ST2, 1, &buf);
 	if (err < 0) {
-		dev_err(&client->dev, "%s: write error\n", __func__);
-		return err;
+		dev_err(&client->dev, "%s: write error, defer probe\n", __func__);
+		return -EPROBE_DEFER;
 	}
 
 	pcf8563->rtc = devm_rtc_allocate_device(&client->dev);
-- 
2.25.1

